[ -f "$HOME/.config/zsh/env.zsh" ] && source "$HOME/.config/zsh/env.zsh"
[ -f "$HOME/.config/zsh/aliases.zsh" ] && source "$HOME/.config/zsh/aliases.zsh"
[ -f "$HOME/.config/zsh/tmux.zsh" ] && source "$HOME/.config/zsh/tmux.zsh"
[ -f "$HOME/.config/zsh/functions/co.zsh" ] && source "$HOME/.config/zsh/functions/co.zsh"

# plugin sudo confilct with zsh-vi-mode
plugins=(git autojump copypath zsh-vi-mode zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

setopt HIST_IGNORE_SPACE
eval "$(starship init zsh)"

. "$HOME/.local/bin/env"
