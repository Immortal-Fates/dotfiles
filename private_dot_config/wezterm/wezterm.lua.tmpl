  { key = "k", mods = "CTRL|CMD", action = wezterm.action.SendKey({ key = "k", mods = "CTRL|ALT" }) },
  { key = "l", mods = "CTRL|CMD", action = wezterm.action.SendKey({ key = "l", mods = "CTRL|ALT" }) },

  { key = "h", mods = "ALT", action = wezterm.action.HideApplication },

  { key = "h", mods = "CMD", action = wezterm.action.SendKey({ key = "h", mods = "ALT" }) },
