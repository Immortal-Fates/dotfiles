# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

{{ if eq .chezmoi.os "darwin" }}
export CODEX_TRACKER_SOCKET="${TMPDIR:-/tmp}/agent-tracker.sock"
{{ else }}
export CODEX_TRACKER_SOCKET="/run/user/1000/agent-tracker.sock"
{{ end }}

conda() {
    unset -f conda
    local conda_root=""
    for candidate in "$HOME/miniconda3" "$HOME/anaconda3" "/opt/homebrew/Caskroom/miniconda/base" "/usr/local/Caskroom/miniconda/base"; do
        if [ -f "$candidate/etc/profile.d/conda.sh" ]; then
            conda_root="$candidate"
            break
        fi
    done

    if [ -n "$conda_root" ]; then
        . "$conda_root/etc/profile.d/conda.sh"
    else
        print -u2 "conda: no conda installation found"
        return 127
    fi
    conda "$@"
}

export NVM_DIR="$HOME/.nvm"
if [ -d "$NVM_DIR/versions/node/v24.16.0/bin" ]; then
    export PATH="$NVM_DIR/versions/node/v24.16.0/bin:$PATH"
fi

nvm() {
    unset -f nvm
{{- if eq .chezmoi.os "darwin" }}
    [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && . "/opt/homebrew/opt/nvm/nvm.sh"
{{- else }}
    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
{{- end }}
    nvm "$@"
}

{{- if eq .chezmoi.os "darwin" }}
if [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ]; then
    fpath=("/opt/homebrew/opt/nvm/etc/bash_completion.d" $fpath)
fi
{{- end }}

export ZSH_DISABLE_COMPFIX=true
export ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-${ZSH_VERSION}"
mkdir -p "${ZSH_COMPDUMP:h}"
