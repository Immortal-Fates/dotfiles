{{ if eq .chezmoi.os "darwin" }}
local wezterm_name = "WezTerm"
local typora_name = "Typora"
local typora_bundle_id = "abnerworks.Typora"
local command_h_hotkey
local typora_sidebar_hotkey
local app_watcher

local function center_window_in_screen_frame(window)
  local screen_frame = window:screen():frame()
  local window_frame = window:frame()

  window_frame.x = screen_frame.x + math.floor((screen_frame.w - window_frame.w) / 2)
  window_frame.y = screen_frame.y + math.floor((screen_frame.h - window_frame.h) / 2)

  window:setFrame(window_frame, 0)
end

local function center_wezterm_windows(app)
  if not app or app:name() ~= wezterm_name then
    return
  end

  for _, window in ipairs(app:allWindows()) do
    if window:isStandard() then
      center_window_in_screen_frame(window)
    end
  end
end

local function is_typora_frontmost()
  local front = hs.application.frontmostApplication()

  return front and (front:bundleID() == typora_bundle_id or front:name() == typora_name)
end

local function toggle_typora_sidebar()
  local front = hs.application.frontmostApplication()

  if is_typora_frontmost() then
    if not front:selectMenuItem({ "View", "Toggle Sidebar" }) then
      front:selectMenuItem({ "显示", "显示／隐藏侧边栏" })
    end

    return true
  end
end

local function update_typora_sidebar_hotkey()
  if is_typora_frontmost() then
    typora_sidebar_hotkey:enable()
  else
    typora_sidebar_hotkey:disable()
  end
end

typora_sidebar_hotkey = hs.hotkey.new({ "ctrl" }, "b", function()
  if is_typora_frontmost() then
    toggle_typora_sidebar()
  end
end)

app_watcher = hs.application.watcher.new(function(app_name, event, app)
  if event == hs.application.watcher.activated or event == hs.application.watcher.deactivated or event == hs.application.watcher.terminated then
    hs.timer.doAfter(0, update_typora_sidebar_hotkey)
  end

  if app_name == wezterm_name and event == hs.application.watcher.launched then
    hs.timer.doAfter(0.5, function()
      center_wezterm_windows(app)
    end)
  end
end)

app_watcher:start()

update_typora_sidebar_hotkey()

hs.hotkey.bind({ "alt" }, "h", function()
  local front = hs.application.frontmostApplication()

  if front then
    front:hide()
  end
end)

command_h_hotkey = hs.hotkey.bind({ "cmd" }, "h", function()
  local front = hs.application.frontmostApplication()

  if front and front:name() == wezterm_name then
    command_h_hotkey:disable()
    hs.eventtap.keyStroke({ "cmd" }, "h", 0, front)
    command_h_hotkey:enable()
  end
end)

hs.hotkey.bind({ "ctrl", "cmd" }, "t", function()
  local front = hs.application.frontmostApplication()

  if front and front:name() == wezterm_name then
    hs.eventtap.keyStroke({ "cmd" }, "t", 0, front)
    return
  end

  hs.application.launchOrFocus(wezterm_name)
end)
{{ end }}
