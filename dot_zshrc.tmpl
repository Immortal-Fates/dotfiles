# OPENSPEC:START
# OpenSpec shell completions configuration
fpath=("$HOME/.oh-my-zsh/custom/completions" $fpath)
# OPENSPEC:END

[ -f "$HOME/.config/zsh/env.zsh" ] && source "$HOME/.config/zsh/env.zsh"
[ -f "$HOME/.config/zsh/aliases.zsh" ] && source "$HOME/.config/zsh/aliases.zsh"
[ -f "$HOME/.config/zsh/tmux.zsh" ] && source "$HOME/.config/zsh/tmux.zsh"
[ -f "$HOME/.config/zsh/yazi.zsh" ] && source "$HOME/.config/zsh/yazi.zsh"
[ -f "$HOME/.config/zsh/functions/co.zsh" ] && source "$HOME/.config/zsh/functions/co.zsh"

ZSH_AUTOSUGGEST_ACCEPT_WIDGETS=()
plugins=(git autojump copypath zsh-vi-mode zsh-autosuggestions zsh-syntax-highlighting)
source "$ZSH/oh-my-zsh.sh"

setopt HIST_IGNORE_SPACE
eval "$(starship init zsh)"
if command -v codex >/dev/null 2>&1; then
  eval "$(codex completion zsh)"
fi

[ -f "$HOME/.config/zsh/keybindings.zsh" ] && source "$HOME/.config/zsh/keybindings.zsh"

if [ -f "$HOME/.local/bin/env" ]; then
  . "$HOME/.local/bin/env"
fi
